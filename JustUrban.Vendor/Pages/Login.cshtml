@page
@model JustUrban.Vendor.Pages.LoginModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Vendor Login - Just Urban</title>
    <partial name="_PwaHead" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light">
    <div class="container py-5" style="max-width: 420px;">
        <div class="card border-0 shadow rounded-4 p-4">
            <h3 class="fw-bold mb-1">Vendor login</h3>
            <p class="text-muted small mb-4">See jobs assigned to you.</p>
            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                <div class="alert alert-danger">@Model.ErrorMessage</div>
            }
            <form method="post">
                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input asp-for="Email" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Password</label>
                    <input asp-for="Password" type="password" class="form-control" />
                </div>
                <button type="submit" class="btn w-100 text-white" style="background:#0f766e;">Log in</button>
            </form>
            <a asp-page="/Register" class="btn btn-outline-dark w-100 mt-3">Sign up as a new vendor</a>
            <p class="small text-muted mt-2 mb-0">Demo: vendor@justurban.local / Vendor@123</p>
            <p class="small text-muted mt-3 mb-0">On iPhone, open this page in Safari, tap Share, then <strong>Add to Home Screen</strong>.</p>
        </div>
    </div>
</body>
</html>
