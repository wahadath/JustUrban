@page
@model JustUrban.Pages.BookingModel
@{
    ViewData["Title"] = "Booking - Home Makeover";
}

<link rel="stylesheet" href="https://jsdelivr.net">

<style>
    .booking-card {
        border-radius: 24px;
        border: 1px solid #edf2f7;
        max-width: 600px;
        background-color: #ffffff;
    }

    .feature-icon-box {
        width: 24px;
        height: 24px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #1a202c !important;
    }

    .brand-purple-btn {
        background-color: #6b46e5;
        color: #ffffff !important;
        border-radius: 14px;
        font-weight: 600;
        letter-spacing: -0.2px;
        height: 56px;
        transition: background-color 0.2s ease, transform 0.1s ease;
        border: none;
        text-decoration: none;
    }

        .brand-purple-btn:hover {
            background-color: #5a36cb;
        }
</style>

<div class="container my-5 py-4 d-flex justify-content-center">
    <div class="card booking-card p-4 p-md-5 shadow-sm w-100">

        <h2 class="fw-bold text-dark mb-4 pb-2 fs-3" style="letter-spacing: -0.5px;">@Model.ServiceDisplayName</h2>

        <div class="d-flex flex-column gap-4 mb-5">
            <!-- Feature Item 1 -->
            <div class="d-flex align-items-start">
                <div class="feature-icon-box me-3 mt-1">
                    <i class="bi bi-patch-check-fill fs-5" style="color: #2d3748 !important;"></i>
                </div>
                <div>
                    <h6 class="fw-semibold text-dark mb-0 fs-5">Expert home upgrade guidance</h6>
                </div>
            </div>

            <!-- Feature Item 2 -->
            <div class="d-flex align-items-start">
                <div class="feature-icon-box me-3 mt-1">
                    <i class="bi bi-person-fill fs-5" style="color: #2d3748 !important;"></i>
                </div>
                <div>
                    <h6 class="fw-semibold text-dark mb-1 fs-5">One point of contact</h6>
                    <p class="text-muted mb-0 fs-6">from consultation to project delivery</p>
                </div>
            </div>
        </div>

        <!-- Clicking this button now navigates directly to the dedicated Slot Calendar Page -->
        <a asp-page="/SelectSlot" asp-route-service="@Model.Service" class="w-100 brand-purple-btn d-flex align-items-center justify-content-center fs-5 shadow-sm">
            Book Consultation at ₹49
        </a>

    </div>
</div>
