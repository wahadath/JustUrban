<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - JustUrban</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/JustUrban.styles.css" asp-append-version="true" />
    <!-- Added Bootstrap Icons for the phone logo -->
    <link rel="stylesheet" href="https://jsdelivr.net">
</head>
<body>
    <!-- HEADER SECTION -->
    <header>
        <nav class="navbar navbar-expand-md navbar-light bg-white border-bottom py-3">
            <div class="container">
                <!-- Brand Logo (Stays Left) -->
                <a class="navbar-brand fw-bold fs-3 text-dark" asp-area="" asp-page="/Index">JustUrban</a>

                <!-- Mobile Menu Toggle Button -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Navigation Links Container -->
                <div class="navbar-collapse collapse d-md-inline-flex justify-content-between align-items-center">

                    <!-- Right-Aligned Navigation Items -->
                    <!-- Right-Aligned Navigation Items -->
<ul class="navbar-nav ms-auto align-items-center gap-3">
    <li class="nav-item">
        <a class="nav-link text-secondary fw-medium" asp-area="" asp-page="/About">About Us</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-secondary fw-medium" asp-area="" asp-page="/Contact">Contact Us</a>
    </li>

    @if (Context.Request.Cookies["IsLoggedIn"] == "true")
    {
        <!-- Dynamic User Profile Icon shown instead of Log In -->
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle d-flex align-items-center gap-2 text-dark fw-bold" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                <div class="rounded-circle bg-dark text-white d-flex align-items-center justify-content-center shadow-sm" style="width: 36px; height: 36px;">
                    👤
                </div>
                <span>Profile</span>
            </a>
            <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3" aria-labelledby="userDropdown">
                <li><a class="dropdown-item py-2" asp-page="/Index" asp-page-handler="Logout">🚪 Log Out</a></li>
            </ul>
        </li>
    }
    else
    {
        <!-- Default State Login Modal Trigger button -->
        <li class="nav-item">
            <button type="button" class="btn btn-outline-dark rounded-pill px-3 btn-sm" data-bs-toggle="modal" data-bs-target="#loginModal">
                Log In
            </button>
        </li>
    }
</ul>


                </div>
            </div>
        </nav>
    </header>

    <!-- PAGE BODY CONTENT -->
    <div class="container-fluid p-0">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- POPUP LOGIN MODAL (Matches screenshot UI precisely) -->
    <div class="modal fade" id="loginModal" tabindex="-1" aria-labelledby="loginModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 480px;">
            <div class="modal-content border-0 p-4 shadow" style="border-radius: 24px; position: relative;">

                <!-- Close Button positioned on top right outside the container card -->
                <button type="button" class="btn-close bg-white rounded-circle p-2 shadow-sm position-absolute"
                        data-bs-dismiss="modal" aria-label="Close"
                        style="top: -50px; right: 0; opacity: 1;"></button>

                <div class="modal-body p-2">
                    <!-- Phone Icon Logo -->
                    <div class="text-primary mb-3">
                        <i class="bi bi-telephone-fill fs-2 p-2 bg-light rounded-3 d-inline-block text-primary" style="color: #2b6cb0 !important;"></i>
                    </div>

                    <!-- Headers -->
                    <h3 class="fw-bold text-dark mb-2" id="loginModalLabel" style="letter-spacing: -0.5px;">Enter your phone number</h3>
                    <p class="text-muted small mb-4">We'll send you a text with a verification code. Standard tariff may apply.</p>

                    <!-- Input Fields Form Group -->
                    <form method="post" asp-page="/Index" asp-page-handler="SendOtp">
                        <div class="input-group mb-4 border rounded-3 overflow-hidden" style="height: 54px;">
                            <!-- Country Code Dropdown selector selection -->
                            <button class="btn btn-light bg-white text-dark border-0 px-3 dropdown-toggle fw-medium" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                +91
                            </button>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-menu-item dropdown-item" href="#">+91 (IN)</a></li>
                                <li><a class="dropdown-menu-item dropdown-item" href="#">+1 (US)</a></li>
                                <li><a class="dropdown-menu-item dropdown-item" href="#">+44 (UK)</a></li>
                            </ul>

                            <!-- Vertical Partition line separator -->
                            <div class="vr my-auto text-muted" style="height: 24px;"></div>

                            <!-- Phone text field -->
                            <input type="tel" name="PhoneNumber" class="form-control border-0 bg-transparent shadow-none ps-3"
                                   placeholder="Enter your phone number" required autocomplete="off" />
                        </div>

                        <!-- Continue Button Submission handler pointer -->
                        <button type="submit" class="w-100 btn py-2 fw-medium text-muted bg-light border-0"
                                style="border-radius: 12px; height: 48px; background-color: #e2e8f0 !important;">
                            Continue
                        </button>
                    </form>

                    <!-- Bottom Terms & Policy Disclaimer Links -->
                    <div class="text-center mt-4 pt-2">
                        <p class="text-secondary mb-0" style="font-size: 0.78rem;">
                            By continuing, you agree to our <a href="/Terms" class="text-dark fw-bold text-decoration-underline">T&C</a> and <a href="/Privacy" class="text-dark fw-bold text-decoration-underline">Privacy policy</a>.
                        </p>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- FOOTER SECTION -->
    <footer class="border-top footer text-muted position-fixed bottom-0 w-100 bg-white py-3">
        <div class="container">
            &copy; 2022 - Just Urban Painting - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <!-- JAVASCRIPT ASSETS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
