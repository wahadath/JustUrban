@page
@model JustUrban.Pages.MyBookingsModel
@{
    ViewData["Title"] = "My bookings";
}

<div class="container my-5" style="max-width: 720px;">
    <h3 class="fw-bold mb-4">My bookings</h3>

    @if (!Model.Bookings.Any())
    {
        <div class="alert alert-light border rounded-3">
            No bookings yet. <a asp-page="/Index">Book a service</a> to see tracking, reschedule, and cancel here.
        </div>
    }
    else
    {
        foreach (var booking in Model.Bookings)
        {
            <a asp-page="/Tracking" asp-route-id="@booking.Id" class="text-decoration-none text-dark">
                <div class="card border-0 shadow-sm mb-3" style="border-radius: 16px;">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="fw-bold mb-1">@booking.ServiceName</h6>
                            <p class="text-muted small mb-0">@booking.SlotDate.ToString("dd MMM yyyy") · @booking.SlotTime</p>
                        </div>
                        <span class="badge rounded-pill @(booking.Status == "Cancelled" ? "bg-danger" : "bg-primary")">@booking.Status</span>
                    </div>
                </div>
            </a>
        }
    }
</div>
