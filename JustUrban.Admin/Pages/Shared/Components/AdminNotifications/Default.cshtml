@model JustUrban.Admin.ViewComponents.AdminNotificationList
<li class="nav-item">
    <details class="notif-details">
        <summary class="nav-link notif-bell" aria-label="Notifications">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                <path d="M8 16a2 2 0 0 0 2-2H6a2 2 0 0 0 2 2m.995-14.901a1 1 0 1 0-1.99 0A5 5 0 0 0 3 6c0 1.098-.5 6-2 7h14c-1.5-1-2-5.902-2-7 0-2.42-1.72-4.44-4.005-4.901"/>
            </svg>
            @if (Model.Count > 0)
            {
                <span class="notif-count">@Model.Count</span>
            }
        </summary>
        <div class="notif-menu">
            <div class="notif-head">Notifications</div>
            @if (Model.Items.Count == 0)
            {
                <div class="notif-empty">That's all your notifications.</div>
            }
            else
            {
                @foreach (var item in Model.Items)
                {
                    <a class="notif-item" href="@item.Href">
                        <span class="notif-mark @(item.Kind == "Vendor" ? "notif-mark-vendor" : "notif-mark-booking")">@(item.Kind == "Vendor" ? "V" : "B")</span>
                        <span class="notif-copy">
                            <span class="notif-title">@item.Title</span>
                            @if (!string.IsNullOrWhiteSpace(item.Detail))
                            {
                                <span class="notif-detail">@item.Detail</span>
                            }
                        </span>
                        <span class="notif-time">@item.When</span>
                    </a>
                }
            }
        </div>
    </details>
</li>
