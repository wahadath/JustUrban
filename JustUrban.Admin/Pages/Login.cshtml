@page
@model JustUrban.Admin.Pages.LoginModel
@{
    Layout = null;
    ViewData["Title"] = "Admin Login";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Login - Just Urban</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light">
    <div class="container py-5" style="max-width: 420px;">
        <div class="card border-0 shadow rounded-4 p-4">
            <h3 class="fw-bold mb-1">Just Urban Admin</h3>
            <p class="text-muted small mb-4">Sign in to manage bookings and vendors.</p>
            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                <div class="alert alert-danger">@Model.ErrorMessage</div>
            }
            <form method="post">
                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input asp-for="Email" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Password</label>
                    <input asp-for="Password" type="password" class="form-control" />
                </div>
                <button type="submit" class="btn w-100 text-white" style="background:#1e3a8a;">Log in</button>
            </form>
            <p class="small text-muted mt-3 mb-0">Demo: admin@justurban.local / Admin@123</p>
        </div>
    </div>
</body>
</html>
